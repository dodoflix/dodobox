#!/bin/sh
# Fast checks before every commit, on staged files only. Enabled by `npm install` (core.hooksPath).
files=$(git diff --cached --name-only --diff-filter=ACMR)
js=$(echo "$files" | grep -E '\.(js|mjs|cjs)$')
[ -n "$js" ] && { echo "$js" | xargs npx eslint || exit 1; }
# unit tests only when code or tests changed
echo "$files" | grep -qE '^(server\.js|src/|test/)' || exit 0
npm test
