{
  "name": "dodobox",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted streaming app: torrent playback, subtitles, profiles",
  "keywords": [
    "streaming",
    "self-hosted",
    "torrent",
    "webtorrent",
    "hls",
    "subtitles",
    "pwa"
  ],
  "homepage": "https://github.com/dodoflix/dodobox#readme",
  "bugs": {
    "url": "https://github.com/dodoflix/dodobox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodoflix/dodobox.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "watch": "node --watch server.js",
    "lint": "eslint .",
    "test": "node --test",
    "desktop": "electron .",
    "dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hls.js": "^1.7.3",
    "qrcode-generator": "^2.0.4",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "author": "Dodobox contributors <43419555+dodoflix@users.noreply.github.com>",
  "build": {
    "appId": "io.github.dodoflix.dodobox",
    "productName": "Dodobox",
    "asar": false,
    "npmRebuild": false,
    "artifactName": "Dodobox-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "desktop/build"
    },
    "files": [
      "server.js",
      "src/**",
      "public/**",
      "desktop/**",
      "package.json",
      "!desktop/prune.cjs"
    ],
    "afterPack": "desktop/prune.cjs",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "desktop/build/icon-mac.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Dodobox-Setup-${version}-${arch}.${ext}",
      "differentialPackage": false
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Dodobox contributors <43419555+dodoflix@users.noreply.github.com>"
    },
    "portable": {
      "artifactName": "Dodobox-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "dodoflix",
      "repo": "dodobox"
    }
  }
}
