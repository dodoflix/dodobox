{
  "name": "dodobox",
  "version": "0.9.0",
  "private": true,
  "description": "Self-hosted streaming app: torrent playback, subtitles, profiles",
  "keywords": [
    "streaming",
    "self-hosted",
    "torrent",
    "webtorrent",
    "hls",
    "subtitles",
    "pwa"
  ],
  "homepage": "https://github.com/dodoflix/dodobox#readme",
  "bugs": {
    "url": "https://github.com/dodoflix/dodobox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodoflix/dodobox.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "watch": "node --watch server.js",
    "lint": "eslint .",
    "bench": "node bench/run.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-timeout=120000 e2e/*.spec.js",
    "test:coverage:unit": "node --test --experimental-test-coverage --test-coverage-include=server.js --test-coverage-include=src/** --test-coverage-exclude=src/translate.js --test-coverage-exclude=src/translate-hq.js --test-coverage-exclude=src/presence.js --test-coverage-exclude=src/net.js --test-coverage-exclude=src/data.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage-unit.lcov test/*.test.js && node scripts/coverage-floor.js coverage-unit.lcov 90",
    "test:coverage:e2e": "node --test --test-timeout=120000 --experimental-test-coverage --test-coverage-include=server.js --test-coverage-include=src/** --test-coverage-exclude=src/translate.js --test-coverage-exclude=src/translate-hq.js --test-coverage-exclude=src/presence.js --test-coverage-exclude=src/net.js --test-coverage-exclude=src/data.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage-e2e.lcov e2e/*.spec.js && node scripts/coverage-floor.js coverage-e2e.lcov 90",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:e2e",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "desktop": "electron .",
    "dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3",
    "qrcode-generator": "^2.0.4",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bittorrent-tracker": "^11.2.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1"
  },
  "author": "Dodobox contributors <43419555+dodoflix@users.noreply.github.com>",
  "build": {
    "appId": "io.github.dodoflix.dodobox",
    "productName": "Dodobox",
    "asar": false,
    "npmRebuild": false,
    "artifactName": "Dodobox-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "desktop/build"
    },
    "files": [
      "server.js",
      "src/**",
      "public/**",
      "desktop/**",
      "package.json",
      "!desktop/prune.cjs"
    ],
    "afterPack": "desktop/prune.cjs",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg"
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "desktop/build/icon-mac.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Dodobox-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Dodobox contributors <43419555+dodoflix@users.noreply.github.com>",
      "icon": "desktop/build/icons"
    },
    "portable": {
      "artifactName": "Dodobox-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "dodoflix",
      "repo": "dodobox"
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
